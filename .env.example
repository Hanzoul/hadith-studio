# Kopieren nach .env und ausfüllen
RENDER_TOKEN=bitte-einen-langen-zufaelligen-schluessel-eintragen
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# öffentliche Adresse des Renderers (für Instagram/Facebook/TikTok muss sie per HTTPS erreichbar sein)
PUBLIC_URL=https://render.deine-domain.de
# so viele Render-Prozesse wie CPU-Kerne (KVM 2 → 2, KVM 4 → 4)
RENDER_WORKERS=2
VIDEO_CRF=28
KEEP_DAYS=7
