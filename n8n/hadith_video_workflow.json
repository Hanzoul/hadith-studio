    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ text: $json.chunk, model_id: 'eleven_multilingual_v2', voice_settings: { stability: 0.5, similarity_boost: 0.75 } }) }}",
    "options": {
     "timeout": 300000,
     "batching": {
      "batch": {
       "batchSize": 1,
       "batchInterval": 1000
      }
     },
     "response": {
      "response": {
